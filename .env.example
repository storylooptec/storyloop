SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key for trusted provider reservations, telemetry and Storage.
SUPABASE_SECRET_KEY=
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only external integrations; never use the NEXT_PUBLIC_ prefix.
# Competition research uses SearchAPI.io directly. SERP_API_KEY belongs to the older integration.
SEARCHAPI_API_KEY=
SEARCHAPI_ENABLED=true
# Existing SEARCHAPI_KEY or SEARCH_API_KEY are also accepted; configure only one.
# Optional override: web-search reservation defaults to the verified $0.01 per tool call.
OPENAI_WEB_SEARCH_COST_PER_CALL_USD=
# Default model has verified token price defaults; other models require configured token rates.
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
SERP_API_KEY=
SERP_API_ENABLED=false
SERP_API_COST_PER_SEARCH_USD=
OPENAI_API_KEY=
OPENAI_API_ENABLED=true
OPENAI_BRIEF_MODEL=gpt-4.1-mini
OPENAI_INPUT_COST_PER_1M_USD=
OPENAI_OUTPUT_COST_PER_1M_USD=
# Use combined key_id:key_secret OR the two separate values below.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_API_ENABLED=false
# A positive USD amount no greater than 100; actual quotes come from the provider.
HIGGSFIELD_MAX_PREVIEW_USD=
# Comma-separated exact, verified provider output CDN hostnames; no wildcards.
HIGGSFIELD_MEDIA_ALLOWED_HOSTS=

# Files use private Supabase Storage buckets created by the storage migration:
# storyloop-brand-assets and storyloop-private-media. No additional credentials.

# Creator auth: demo until SMS provider is configured; switch to otp for production SMS.
CREATOR_AUTH_MODE=demo
